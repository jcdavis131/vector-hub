{
  "cleanUrls": true,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "headers": [
    {"source": "/(.*)", "headers": [{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"},{"key":"X-Content-Type-Options","value":"nosniff"}]},
    {"source": "/sw.js","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]}
  ],
  "rewrites": [{"source": "/(.*)", "destination": "/index.html"}]
}
