# PRIVATE dev-only — never commit raw key
# Scope: dev
# Prefix: dm_dev_ required

DUMBMODEL_DEV_API_KEY=dm_dev_LOCAL_ONLY_REPLACE_ME

# Notes:
# - scope=dev, never prod
# - server validates prefix dm_dev_ + timingSafeEqual (Node: crypto.timingSafeEqual)
# - never log raw key, never commit to git
# - CORS allowlist only: http://localhost:3000, http://127.0.0.1:3000, https://*.dumbmodel.local
# - Add to gitignore: dm_dev_*
# - Rotation: replace locally, revoke old within 1h
# - Example usage: Authorization: Bearer dm_dev_LOCAL_ONLY_REPLACE_ME

DUMBMODEL_DEV_API_URL=http://localhost:3000
# Optional TLS local: https://api.dumbmodel.local
NODE_ENV=development
ZERO_DEPS=true
TORCH_DEVICE=auto # auto cuda else cpu per spec
