  "mode": "task",
  "owner": "operator",
  "schedule": {
    "kind": "daily",
    "time": "08:30:00",
    "timezone": "America/Chicago"
  },
  "tags": ["goal","health","slip-proof","operator"],
  "timeout_secs": 300,
  "version": "1.1"
}
