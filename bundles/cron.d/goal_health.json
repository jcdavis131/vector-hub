{
  "command": "python3 ~/workspace/bundles/scripts/goal_health_check.py",
  "created": "2026-08-06",
  "description": "Goal Slip-Proof daily healthcheck — ensures Goal TRACKS Task / REALIZES Project, creates placeholder when needs_tasks, logs to goal_health.jsonl + timeline.jsonl even no-change 7-field",
  "enabled": true,
  "id": "goal_health",
  "logging": {
    "also": "bundles/memory/goal_health.jsonl",
