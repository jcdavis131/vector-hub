{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)\\.(json|js|css|png|webp|svg|woff2|f32|bin)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable, stale-while-revalidate=86400"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.f32",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/manifest.who-e.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/who-e-landing.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, stale-while-revalidate=600"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, stale-while-revalidate=600"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "Vary",
          "value": "Authorization, Origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Authorization,Content-Type,X-Dumbmodel-Key"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://*.dumbmodel.com"
        },
        {
          "key": "X-CORS-Regex",
          "value": "*.dumbmodel.com localhost *.vercel.app regex GET,POST,OPTIONS headers Authorization JSON-or-CSV timingSafeEqual dm_scout_* 120/min key 60/min IP 429"
        },
        {
          "key": "X-API-Version",
          "value": "v67-free-knowledge-edge-money"
        },
        {
          "key": "X-Provenance",
          "value": "7/7/0 honest"
        },
        {
          "key": "X-Kill-Switch",
          "value": "1% day loss → halt"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/arena",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/arena.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/arena/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/unified-old",
      "destination": "/models/unified.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/index",
      "destination": "/index.html"
    },
    {
      "source": "/api/v1/roster",
      "destination": "/api/v1/roster.js"
    },
    {
      "source": "/api/v1/free",
      "destination": "/api/v1/free.js"
    },
    {
      "source": "/unified",
      "destination": "/models/unified.html"
    },
    {
      "source": "/unified/",
      "destination": "/models/unified.html"
    },
    {
      "source": "/models/unified",
      "destination": "/models/unified.html"
    },
    {
      "source": "/unified.html",
      "destination": "/models/unified.html"
    },
    {
      "source": "/hoops",
      "destination": "/models/hoops.html"
    },
    {
      "source": "/hoops/",
      "destination": "/models/hoops.html"
    },
    {
      "source": "/models/hoops",
      "destination": "/models/hoops.html"
    },
    {
      "source": "/gridiron",
      "destination": "/models/gridiron.html"
    },
    {
      "source": "/gridiron/",
      "destination": "/models/gridiron.html"
    },
    {
      "source": "/models/gridiron",
      "destination": "/models/gridiron.html"
    },
    {
      "source": "/pitch",
      "destination": "/models/pitch.html"
    },
    {
      "source": "/pitch/",
      "destination": "/models/pitch.html"
    },
    {
      "source": "/models/pitch",
      "destination": "/models/pitch.html"
    },
    {
      "source": "/equities",
      "destination": "/models/equities.html"
    },
    {
      "source": "/equities/",
      "destination": "/models/equities.html"
    },
    {
      "source": "/models/equities",
      "destination": "/models/equities.html"
    },
    {
      "source": "/tennis",
      "destination": "/models/tennis.html"
    },
    {
      "source": "/tennis/",
      "destination": "/models/tennis.html"
    },
    {
      "source": "/models/tennis",
      "destination": "/models/tennis.html"
    },
    {
      "source": "/game",
      "destination": "/game/index.html"
    },
    {
      "source": "/game/",
      "destination": "/game/index.html"
    },
    {
      "source": "/owner",
      "destination": "/owner/index.html"
    },
    {
      "source": "/owner/",
      "destination": "/owner/index.html"
    },
    {
      "source": "/investor",
      "destination": "/investor/index.html"
    },
    {
      "source": "/investor/",
      "destination": "/investor/index.html"
    },
    {
      "source": "/who-e",
      "destination": "/who-e-landing.html"
    },
    {
      "source": "/who-e/",
      "destination": "/who-e-landing.html"
    },
    {
      "source": "/who-e-landing",
      "destination": "/who-e-landing.html"
    },
    {
      "source": "/who-e.com",
      "destination": "/who-e-landing.html"
    },
    {
      "source": "/who-e.com/",
      "destination": "/who-e-landing.html"
    }
  ],
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "."
}
