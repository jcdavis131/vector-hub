# dumbmodel.com API keys — set in Vercel Dashboard → Settings → Environment Variables
# Generate with: openssl rand -hex 32
DUMBMODEL_API_KEY=dm_scout_xxx_your_primary_key_here
DUMBMODEL_API_KEYS=["dm_scout_xxx","dm_admin_yyy"]
# optional: comma list works too
# DUMBMODEL_API_KEYS=dm_scout_aaa,dm_admin_bbb

# Keys:
# - dm_scout_* — Scout's personal key for dev (read+write, tier scout)
# - dm_admin_* — your admin key (read+write+admin)
# - dm_ext_* — third-party read-only
