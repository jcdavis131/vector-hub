# Skip heavy ML / data folders for Vercel static deploy.
# Anchor /data/ to repo root only — bare `data/` also matches
# public/assets/data/ and strips the gateway products.json (404).
pipeline/
/data/
/assets/data/
datasets/
__pycache__/
*.pyc
*.pyo
*.npz
*.npy
*.pt
*.pth
*.parquet
*.csv
node_modules/
.venv/
venv/
exports/
bundles/
*.log
# Heavy public datasets stay out of the deploy; keep gateway JSON assets.
public/assets/data/*
!public/assets/data/products.json
!public/assets/data/season_clock_demo.json
