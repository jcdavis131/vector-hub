# Skip heavy ML / data folders for Vercel static deploy
# Anchored to repo root (leading /) so these don't also match nested dirs of the
# same name that ARE meant to deploy, e.g. public/assets/data/ (D2, 2026-09-06).
/pipeline/
/data/
/datasets/
__pycache__/
*.pyc
*.pyo
*.npz
*.npy
*.pt
*.pth
*.parquet
*.csv
node_modules/
.venv/
venv/
exports/
bundles/
*.log
